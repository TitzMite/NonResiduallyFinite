
F4 := FreeGroup(4);

GammaSV := F4 / [
    F4.1*F4.3*F4.1*F4.4,
    F4.1*F4.4*F4.1*F4.3,
    F4.1^-1*F4.3^-1*F4.1^-1*F4.4^-1,
    F4.1^-1*F4.4^-1*F4.1^-1*F4.3^-1,

    F4.1*F4.3^-1*F4.2*F4.3^-1,
    F4.2*F4.3^-1*F4.1*F4.3^-1,
    F4.2^-1*F4.3*F4.1^-1*F4.3,
    F4.1^-1*F4.3*F4.2^-1*F4.3,

    F4.1*F4.4^-1*F4.2^-1*F4.4^-1,
    F4.2^-1*F4.4^-1*F4.1*F4.4^-1,
    F4.2*F4.4*F4.1^-1*F4.4,
    F4.1^-1*F4.4*F4.2*F4.4,

    F4.2*F4.3*F4.2*F4.4^-1,
    F4.2*F4.4^-1*F4.2*F4.3,
    F4.2^-1*F4.3^-1*F4.2^-1*F4.4,
    F4.2^-1*F4.4*F4.2^-1*F4.3^-1
];

GammaJW := F4 / [
    F4.1*F4.3*F4.1*F4.4,
    F4.1*F4.4*F4.1*F4.3,
    F4.1^-1*F4.3^-1*F4.1^-1*F4.4^-1,
    F4.1^-1*F4.4^-1*F4.1^-1*F4.3^-1,

    F4.1*F4.3^-1*F4.2*F4.4^-1,
    F4.2*F4.4^-1*F4.1*F4.3^-1,
    F4.2^-1*F4.3*F4.1^-1*F4.4,
    F4.1^-1*F4.4*F4.2^-1*F4.3,

    F4.1*F4.4^-1*F4.2^-1*F4.3^-1,
    F4.2^-1*F4.3^-1*F4.1*F4.4^-1,
    F4.2*F4.4*F4.1^-1*F4.3,
    F4.1^-1*F4.3*F4.2*F4.4,

    F4.2*F4.3*F4.2^-1*F4.4^-1,
    F4.2^-1*F4.4^-1*F4.2*F4.3,
    F4.2*F4.3^-1*F4.2^-1*F4.4,
    F4.2^-1*F4.4*F4.2*F4.3^-1
];

F6 := FreeGroup(6);

GammaCV := F6 / [
    F6.3^2,
    F6.4^2,
    F6.5^2,
    F6.6^2,

    F6.1*F6.3*F6.2^-1*F6.5,
    F6.2^-1*F6.5*F6.1*F6.3,
    F6.2*F6.3*F6.1^-1*F6.5,
    F6.1^-1*F6.5*F6.2*F6.3,

    F6.1*F6.4*F6.1^-1*F6.6,
    F6.1^-1*F6.6*F6.1*F6.4,

    F6.1*F6.5*F6.1^-1*F6.3,
    F6.1^-1*F6.3*F6.1*F6.5,

    F6.1*F6.6*F6.1^-1*F6.4,
    F6.1^-1*F6.4*F6.1*F6.6,

    F6.2*F6.4*F6.2^-1*F6.3,
    F6.2^-1*F6.3*F6.2*F6.4,

    F6.2*F6.5*F6.2^-1*F6.6,
    F6.2^-1*F6.6*F6.2*F6.5,

    F6.2*F6.6*F6.2^-1*F6.4,
    F6.2^-1*F6.4*F6.2*F6.6
];